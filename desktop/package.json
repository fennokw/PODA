{
  "name": "poda-desktop",
  "productName": "PODA",
  "version": "0.9.3",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "npm run stage:backend && electron .",
    "package:mac": "node package-mac.cjs",
    "stage:backend": "python3 stage_backend.py .backend"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.2.3"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.2",
      "minimatch": "11.0.1"
    }
  },
  "podaSetupFiles": [
    "SETUP_DESKTOP.command",
    "setup-runtime.command"
  ]
}
